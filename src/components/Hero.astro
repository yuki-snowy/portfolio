---
import { site } from "../data/site";
---

<section
  class="relative min-h-dvh snap-start snap-always bg-frame text-ink"
  aria-label="ヒーロー"
  data-top-section
>
  <div
    class="mx-auto flex min-h-dvh max-w-[1600px] flex-col px-6 pb-8 pt-24 md:px-10 md:pb-10 md:pt-28 lg:px-14 lg:pb-12"
  >
    <div class="relative min-h-0 flex-1 overflow-hidden">
      <img
        src="/images/hero/kv-bg.jpg"
        alt=""
        class="hero-kv absolute inset-0 h-full w-full object-cover"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-white/58"
        aria-hidden="true"
      />

      <div
        class="absolute inset-0 flex items-center justify-end px-6 pb-10 pt-16 md:px-12 md:pb-14 lg:px-16"
      >
        <div class="animate-rise max-w-[min(100%,28rem)] text-left md:max-w-none">
          <h1 class="font-sans text-[clamp(2.75rem,11vw,6.5rem)] font-black leading-[0.92] tracking-[0.02em]">
            <span class="block">YUKI</span>
            <span class="block">PORTFOLIO</span>
          </h1>
          <p
            class="animate-rise mt-5 text-[10px] font-medium tracking-[0.32em] text-ink/85 md:mt-7 md:text-[11px]"
            style="animation-delay: 140ms"
          >
            {site.heroTagline}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
