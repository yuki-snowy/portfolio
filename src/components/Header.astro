---
import { navItems, site } from "../data/site";
import SiteLogo from "./SiteLogo.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";
---

<header
  class:list={[
    "site-header pointer-events-none fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,color] duration-400",
    isHome ? "home-header" : "text-paper",
  ]}
  data-header-root
  data-tone={isHome ? "light" : "dark"}
  data-scrolled="false"
  data-home={isHome ? "true" : "false"}
>
  <div
    class:list={[
      "pointer-events-auto mx-auto flex items-center justify-between",
      isHome
        ? "max-w-[1600px] px-6 py-5 md:px-10 md:py-6 lg:px-14"
        : "max-w-7xl px-5 py-5 md:px-8",
    ]}
  >
    <a
      href="/"
      class="group relative z-[70] block shrink-0"
      aria-label={`${site.title} トップへ`}
      data-header-logo
    >
      {
        isHome ? (
          <>
            <SiteLogo tone="light" class="site-logo--on-light" />
            <SiteLogo tone="dark" class="site-logo--on-dark" />
          </>
        ) : (
          <SiteLogo tone="dark" />
        )
      }
    </a>

    {
      !isHome && (
        <nav class="hidden md:block" aria-label="メインナビゲーション">
          <ul class="flex items-center gap-10">
            {
              navItems.map((item) => {
                const current = path === item.href || path.startsWith(`${item.href}/`);
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={current ? "page" : undefined}
                      class:list={[
                        "text-[11px] tracking-[0.12em] transition-colors duration-300",
                        current ? "text-paper" : "text-sand/80 hover:text-paper",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      )
    }

    <button
      type="button"
      class:list={[
        "relative z-[70] flex h-11 w-11 items-center justify-center text-current",
        !isHome && "md:hidden",
      ]}
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="メニューを開く"
    >
      <span class="sr-only">メニュー</span>
      <span class="nav-burger relative block h-3.5 w-6" aria-hidden="true">
        <i data-bar class="absolute left-0 top-0 block h-px w-full bg-current transition duration-300"></i>
        <i data-bar class="absolute left-0 top-1/2 block h-px w-full -translate-y-1/2 bg-current transition duration-300"></i>
        <i data-bar class="absolute bottom-0 left-0 block h-px w-full bg-current transition duration-300"></i>
      </span>
    </button>
  </div>

  <div
    id="mobile-nav"
    data-nav-panel
    hidden
    class:list={[
      "pointer-events-auto fixed inset-0 z-[60] flex items-center justify-center bg-ink",
      !isHome && "md:hidden",
    ]}
  >
    <nav aria-label="メニュー">
      <ul class="flex flex-col items-center gap-10 md:gap-12">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-sans text-3xl font-bold tracking-[0.08em] text-paper transition-opacity duration-300 hover:opacity-70 md:text-4xl"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function setupHeader() {
    const header = document.querySelector<HTMLElement>("[data-header-root]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-nav-panel]");
    const logo = document.querySelector<HTMLElement>("[data-header-logo]");
    if (!header || !toggle || !panel) return;

    const SCROLL_THRESHOLD = 24;

    const setScrolled = (scrolled: boolean) => {
      header.dataset.scrolled = String(scrolled);
    };

    const updateScroll = () => {
      const snapRoot = document.querySelector<HTMLElement>("[data-snap-root]");
      const top = snapRoot ? snapRoot.scrollTop : window.scrollY;
      setScrolled(top > SCROLL_THRESHOLD);
    };

    if (header.dataset.scrollBound !== "true") {
      header.dataset.scrollBound = "true";
      const snapRoot = document.querySelector<HTMLElement>("[data-snap-root]");
      if (snapRoot) {
        snapRoot.addEventListener("scroll", updateScroll, { passive: true });
      } else {
        window.addEventListener("scroll", updateScroll, { passive: true });
      }
    }
    updateScroll();

    if (toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
      panel.hidden = !open;
      document.body.style.overflow = open ? "hidden" : "";
      header.dataset.menuOpen = String(open);
      if (logo) logo.style.visibility = open ? "hidden" : "";
      if (open) {
        header.dataset.tone = "dark";
      } else if (header.dataset.home === "true") {
        const snapTone = document.documentElement.dataset.snapTone;
        header.dataset.tone = snapTone === "dark" ? "dark" : "light";
      } else {
        header.dataset.tone = "dark";
      }
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }

  document.addEventListener("astro:page-load", setupHeader);
  setupHeader();
</script>
