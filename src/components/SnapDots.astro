---
interface Props {
  labels: string[];
}

const { labels } = Astro.props;
---

<nav
  class="pointer-events-none fixed right-4 top-1/2 z-40 hidden -translate-y-1/2 md:block"
  aria-label="セクション"
>
  <ol class="pointer-events-auto flex flex-col gap-3">
    {
      labels.map((label, index) => (
        <li>
          <a
            href={`#section-${index}`}
            data-snap-dot={index}
            class="group flex items-center justify-end gap-3"
            aria-label={label}
          >
            <span class="text-[10px] tracking-[0.24em] text-mute opacity-0 transition group-hover:opacity-100">
              {label}
            </span>
            <span
              class="block h-1.5 w-1.5 rounded-full bg-paper/30 ring-1 ring-paper/20 transition data-[active=true]:bg-paper"
              data-dot
            ></span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
