---
interface Props {
  labels: string[];
}

const { labels } = Astro.props;
---

<nav
  class="pointer-events-none fixed right-5 top-1/2 z-40 hidden -translate-y-1/2 md:block lg:right-8"
  aria-label="セクション"
  data-snap-nav
>
  <ol class="pointer-events-auto flex flex-col gap-4">
    {
      labels.map((label, index) => (
        <li>
          <a
            href={`#section-${index}`}
            data-snap-dot={index}
            class="group flex items-center justify-end gap-3"
            aria-label={label}
          >
            <span
              class="snap-dot-label text-[10px] tracking-[0.16em] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              data-snap-label
            >
              {label}
            </span>
            <span
              class="snap-dot-marker block h-2 w-2 rotate-45 border border-current transition-[background-color,border-color,transform] duration-300 data-[active=true]:scale-110 data-[active=true]:border-gold data-[active=true]:bg-gold"
              data-dot
            />
          </a>
        </li>
      ))
    }
  </ol>
</nav>
