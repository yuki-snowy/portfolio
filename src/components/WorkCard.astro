---
import type { CollectionEntry } from "astro:content";

interface Props {
  work: CollectionEntry<"works">;
}

const { work } = Astro.props;
---

<article>
  <a href={`/works/${work.id}`} class="group block">
    <div class="overflow-hidden bg-ink-soft">
      <img
        src={work.data.thumbnail}
        alt={`${work.data.title} のサムネイル`}
        class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-[1.03]"
        width="960"
        height="600"
        loading="lazy"
      />
    </div>
    <div class="mt-5 flex items-start justify-between gap-4">
      <div>
        <h2 class="font-serif text-2xl tracking-[0.08em] text-paper md:text-3xl">
          {work.data.title}
        </h2>
        <p class="mt-2 text-[11px] tracking-[0.28em] text-mute">{work.data.category}</p>
      </div>
      <span class="mt-2 text-[11px] tracking-[0.24em] text-sand transition-colors group-hover:text-paper">
        VIEW
      </span>
    </div>
  </a>
</article>
