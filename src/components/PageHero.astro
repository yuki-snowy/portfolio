---
import { ui } from "../data/ui";

interface Props {
  title: string;
  kicker?: string;
  image: string;
  dark?: boolean;
}

const { title, kicker = ui.webEngineering, image, dark = true } = Astro.props;
---

<section class="relative isolate min-h-[58vh] overflow-hidden md:min-h-[68vh]">
  <img
    src={image}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    width="1600"
    height="900"
  />
  <div
    class:list={[
      "absolute inset-0",
      dark
        ? "bg-gradient-to-t from-ink via-ink/50 to-ink/25"
        : "bg-gradient-to-t from-paper via-paper/20 to-transparent",
    ]}
  >
  </div>
  <div class="relative mx-auto flex min-h-[58vh] max-w-7xl items-end px-5 pb-14 pt-28 md:min-h-[68vh] md:px-8 md:pb-16">
    <div>
      <h1 class="font-serif text-5xl leading-none tracking-[0.08em] text-paper md:text-7xl">
        {title}
      </h1>
      <div class="mt-5 flex items-center gap-4 text-[11px] tracking-[0.32em] text-sand">
        <span class="h-px w-10 bg-sand/70"></span>
        {kicker}
      </div>
    </div>
  </div>
</section>
