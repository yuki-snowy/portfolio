---
import { ui } from "../data/ui";
import { site } from "../data/site";
---

<form
  class="mt-12 space-y-8"
  data-reveal
  data-reveal-delay="1"
  name="contact"
  method="POST"
  action="/contact/thanks"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-contact-form
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>
      空欄のままにしてください
      <input name="bot-field" />
    </label>
  </p>

  <div class="grid gap-8 md:grid-cols-2">
    <label class="block">
      <span class="flex items-center gap-1 text-[11px] tracking-[0.2em] text-sand">
        {ui.form.name} <span class="text-paper" aria-hidden="true">*</span>
      </span>
      <input
        class="mt-3 w-full border-b border-line-strong bg-transparent py-3 text-paper placeholder:text-mute/60"
        name="name"
        type="text"
        autocomplete="name"
        placeholder={ui.form.namePlaceholder}
        required
      />
    </label>
    <label class="block">
      <span class="flex items-center gap-1 text-[11px] tracking-[0.2em] text-sand">
        {ui.form.email} <span class="text-paper" aria-hidden="true">*</span>
      </span>
      <input
        class="mt-3 w-full border-b border-line-strong bg-transparent py-3 text-paper placeholder:text-mute/60"
        name="email"
        type="email"
        autocomplete="email"
        placeholder={`例：${site.emailPlaceholder}`}
        required
      />
    </label>
  </div>

  <label class="block">
    <span class="flex items-center gap-1 text-[11px] tracking-[0.2em] text-sand">
      {ui.form.message} <span class="text-paper" aria-hidden="true">*</span>
    </span>
    <textarea
      class="mt-3 min-h-40 w-full border-b border-line-strong bg-transparent py-3 text-paper"
      name="text"
      required
    ></textarea>
  </label>

  <button
    class="inline-flex items-center gap-3 border border-paper/40 px-8 py-3 text-[11px] tracking-[0.2em] text-paper transition hover:bg-paper hover:text-ink"
    type="submit"
  >
    {ui.form.submit}
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  form?.addEventListener("submit", (event) => {
    const host = window.location.hostname;
    const usesNetlify = host.includes("netlify");
    if (!usesNetlify) {
      event.preventDefault();
      window.location.assign("/contact/thanks");
    }
  });
</script>
