---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  theme?: "dark" | "light";
  footer?: boolean;
  class?: string;
}

const {
  title = site.title,
  description = site.description,
  ogImage = site.ogImage,
  theme = "dark",
  footer = true,
  class: className = "",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const pageTitle = title === site.title ? title : `${title} — ${site.title}`;
const og = new URL(ogImage, Astro.site ?? site.url);
---

<!doctype html>
<html lang="ja" data-theme={theme} class="bg-ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0b" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.href} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={site.favicon} type="image/png" />
    <link rel="apple-touch-icon" href={site.favicon} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body class:list={["min-h-dvh", className]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:bg-paper focus:px-4 focus:py-2 focus:text-ink"
    >
      本文へスキップ
    </a>
    <Header />
    <slot />
    {footer && <Footer />}
    <script>
      function setupReveal() {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll("[data-reveal]");
        if (reduce) {
          els.forEach((el) => el.setAttribute("data-visible", ""));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.setAttribute("data-visible", "");
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -5% 0px" },
        );

        els.forEach((el) => io.observe(el));
      }

      setupReveal();
      document.addEventListener("astro:page-load", setupReveal);
    </script>
  </body>
</html>
