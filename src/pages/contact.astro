---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { ui } from "../data/ui";
---

<BaseLayout title={ui.pages.contact.title}>
  <main id="main" class="mx-auto max-w-3xl px-5 pb-24 pt-32 md:px-8">
    <h1 class="animate-rise font-serif text-5xl tracking-[0.04em] md:text-7xl">
      {ui.pages.contact.title}
    </h1>
    <p class="animate-rise mt-8 text-sm leading-8 text-paper/80" style="animation-delay: 120ms">
      ご質問・ご連絡はこちらからどうぞ。<br />
      <span class="text-sand">*</span>は必須項目です。
    </p>
    <ContactForm />
  </main>
</BaseLayout>
