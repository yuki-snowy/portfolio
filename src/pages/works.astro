---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import WorkCard from "../components/WorkCard.astro";
import { getCollection } from "astro:content";
import { sortWorks } from "../lib/works";
import { ui } from "../data/ui";

const works = sortWorks(await getCollection("works"));
---

<BaseLayout title={ui.pages.works.title}>
  <main id="main">
    <PageHero
      title={ui.pages.works.title}
      kicker={ui.pages.works.kicker}
      image="/images/works/list-bg.jpg"
    />
    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
      <div class="grid gap-12 md:grid-cols-2 md:gap-x-10 md:gap-y-16">
        {
          works.map((work, index) => (
            <div data-reveal data-reveal-delay={String(Math.min(index, 3))}>
              <WorkCard work={work} />
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
