---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui } from "../data/ui";
---

<BaseLayout title={ui.pages.notFound.title}>
  <main id="main" class="mx-auto max-w-3xl px-5 pb-24 pt-32 md:px-8">
    <p class="text-[11px] tracking-[0.4em] text-sand">{ui.pages.notFound.kicker}</p>
    <h1 class="mt-4 font-serif text-5xl tracking-[0.08em] md:text-7xl">
      {ui.pages.notFound.title}
    </h1>
    <p class="mt-8 text-sm leading-8 text-paper/80">
      お探しのページは見つかりませんでした。
    </p>
    <a
      href="/"
      class="mt-12 inline-flex items-center gap-3 border-b border-sand/70 pb-1 text-[11px] tracking-[0.2em] hover:border-paper"
    >
      {ui.backToTop}
    </a>
  </main>
</BaseLayout>
