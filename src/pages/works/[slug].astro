---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { getCollection, render } from "astro:content";
import { sortWorks } from "../../lib/works";
import { ui } from "../../data/ui";

export async function getStaticPaths() {
  const works = sortWorks(await getCollection("works"));
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout title={work.data.seoTitle ?? work.data.title} ogImage={work.data.heroImage}>
  <main id="main">
    <PageHero
      title={work.data.title}
      kicker={work.data.category}
      image={work.data.heroImage}
    />
    <article class="mx-auto grid max-w-7xl gap-16 px-5 py-16 md:grid-cols-12 md:px-8 md:py-24">
      <aside class="space-y-10 md:col-span-4" data-reveal>
        <div>
          <h2 class="text-[11px] tracking-[0.2em] text-sand">{ui.workDetail.tools}</h2>
          <ul class="mt-3 space-y-1 text-sm leading-7 text-paper/85">
            {work.data.tools.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-[11px] tracking-[0.2em] text-sand">{ui.workDetail.period}</h2>
          <p class="mt-3 text-sm text-paper/85">{work.data.period}</p>
        </div>
        {
          (work.data.repoUrl || work.data.liveUrl) && (
            <div>
              <h2 class="text-[11px] tracking-[0.2em] text-sand">{ui.workDetail.links}</h2>
              <ul class="mt-3 space-y-2 text-sm leading-7">
                {work.data.repoUrl && (
                  <li>
                    <a
                      href={work.data.repoUrl}
                      class="text-sand underline-offset-4 hover:text-paper hover:underline"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      GitHub
                    </a>
                  </li>
                )}
                {work.data.liveUrl && (
                  <li>
                    <a
                      href={work.data.liveUrl}
                      class="text-sand underline-offset-4 hover:text-paper hover:underline"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Live Demo
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )
        }
        <div>
          <h2 class="text-[11px] tracking-[0.2em] text-sand">{ui.workDetail.comment}</h2>
          <div class="mt-3 space-y-4 text-sm leading-8 text-paper/80">
            <Content />
          </div>
        </div>
      </aside>
      <div class="space-y-6 md:col-span-8">
        {
          work.data.gallery.map((src, index) => (
            <img
              src={src}
              alt={`${work.data.title} キャプチャ ${index + 1}`}
              class="w-full bg-ink-soft"
              data-reveal
              data-reveal-delay={String(Math.min(index, 3))}
              width="1400"
              height="900"
              loading={index === 0 ? "eager" : "lazy"}
            />
          ))
        }
      </div>
    </article>
    <nav class="mx-auto flex max-w-7xl justify-between px-5 pb-20 text-[11px] tracking-[0.2em] md:px-8">
      <a href="/works" class="text-sand hover:text-paper">{ui.pages.works.title}</a>
      <a href="/" class="text-sand hover:text-paper">{ui.top}</a>
    </nav>
  </main>
</BaseLayout>
